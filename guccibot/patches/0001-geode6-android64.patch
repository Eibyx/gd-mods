+ 	m_reloading = true;
+ }
+ 
++// GucciBot patch: screen pixels per ImGui unit (imgui-cocos.hpp).
++static float s_frameScale = 1.f;
++
++void ImGuiCocos::setFrameScale(float scale) {
++	s_frameScale = scale > 0.f ? scale : 1.f;
++}
++
+ ImVec2 ImGuiCocos::cocosToFrame(const CCPoint& pos) {
+ 	auto* director = CCDirector::sharedDirector();
+ 	const auto frameSize = director->getOpenGLView()->getFrameSize() * geode::utils::getDisplayFactor();
+ 	const auto winSize = director->getWinSize();
+ 
+ 	return {
+-		pos.x / winSize.width * frameSize.width,
+-		(1.f - pos.y / winSize.height) * frameSize.height
++		pos.x / winSize.width * frameSize.width / s_frameScale,
++		(1.f - pos.y / winSize.height) * frameSize.height / s_frameScale
+ 	};
+ }
+ 
+@@ -307,8 +314,8 @@ CCPoint ImGuiCocos::frameToCocos(const ImVec2& pos) {
