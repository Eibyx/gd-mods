++		pos.x * s_frameScale / frameSize.width * winSize.width,
++		(1.f - pos.y * s_frameScale / frameSize.height) * winSize.height
+ 	};
+ }
+ 
+@@ -345,7 +352,7 @@ void ImGuiCocos::newFrame() {
