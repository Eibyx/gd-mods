+@@ -72,4 +72,10 @@ public:
+ 	static cocos2d::CCPoint frameToCocos(const ImVec2& pos);
+ 
+ 	void runPreDrawCall();
++
++	// GucciBot patch (Android and iOS builds only): screen pixels per ImGui
++	// unit. ImGui lays out a display this many times smaller than the GL
++	// frame, its output is drawn this many times bigger and touches are mapped
++	// to match, so the whole interface grows together. 1 changes nothing.
++	static void setFrameScale(float scale);
+ };
